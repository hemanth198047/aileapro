AILEAPRO_API_PORT=8090
AILEAPRO_WEB_ORIGIN=http://localhost:3000
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aileapro
SPRING_DATASOURCE_USERNAME=aileapro
SPRING_DATASOURCE_PASSWORD=aileapro
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
# Development only — never commit real secrets
AILEAPRO_AI_PROVIDER=fake
# Optional SMTP (when unset, auth tokens are logged by the API)
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# AILEAPRO_MAIL_FROM=noreply@example.com
# Production: set a real AI provider + lab executor URL (fake refused at startup)
# AILEAPRO_AI_PROVIDER=openai
# AILEAPRO_LAB_EXECUTOR=http
# AILEAPRO_EXECUTOR_URL=http://executor:8082
